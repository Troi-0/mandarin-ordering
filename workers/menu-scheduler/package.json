{
  "name": "mandarin-ordering-scheduler",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "types": "wrangler types",
    "check:types": "wrangler types --check",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --coverage",
    "test:workerd": "vitest run --project workerd",
    "bundle": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "check": "npm run check:types && npm run typecheck && npm run test:unit && npm run test:workerd && npm run bundle",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.124.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
